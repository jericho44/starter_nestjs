generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/analytics"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

model Log {
  id        String   @id @default(uuid())
  action    String
  userId    String
  details   Json?
  createdAt DateTime @default(now())

  @@map("logs")
}
